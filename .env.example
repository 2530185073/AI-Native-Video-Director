# ---- AI Director (LLM) -------------------------------------------------------
# 任何 OpenAI-compatible 端点都可以；默认走 Gemini 的 OpenAI 兼容层。
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-pro
LLM_TEMPERATURE=0.7
# json_schema | json_object | none （端点不支持结构化输出时自动降级）
LLM_STRUCTURED_OUTPUT=json_schema

# ---- ASR / 逐字对照 -------------------------------------------------------------
# auto | external | groq
ASR_PROVIDER=auto
# 你自己的“文案 ↔ 音频 逐字对照”接口（返回带时间戳的字/词即可，格式宽松解析）
ASR_ALIGN_URL=
ASR_ALIGN_API_KEY=
ASR_ALIGN_METHOD=POST
ASR_ALIGN_AUDIO_FIELD=audio_url
ASR_ALIGN_TEXT_FIELD=text
ASR_ALIGN_LANGUAGE_FIELD=language
# 兜底：Groq Whisper（词级时间戳 + 本地字符级对齐）
GROQ_API_KEY=
GROQ_WHISPER_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_WHISPER_MODEL=whisper-large-v3

# ---- VectCut 流光剪辑 -----------------------------------------------------------
VECTCUT_API_KEY=
VECTCUT_BASE_URL=https://open.vectcut.com

# ---- B-roll 图片生成 -------------------------------------------------------------
# vectcut（用 VectCut 聚合生图，无需上传）| openai-compatible（含 Gemini/Imagen）| none
IMAGE_PROVIDER=vectcut
VECTCUT_IMAGE_MODEL=nano_banana_2
# 仅 openai-compatible 时需要：
IMAGE_API_KEY=
IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
IMAGE_MODEL=imagen-4.0-generate-001
