# ---- AI Director (LLM) -------------------------------------------------------
# 默认：Gemini 原生 generateContent（models/{model}:generateContent）。
# LLM_PROVIDER=gemini | openai-compatible
LLM_PROVIDER=gemini
LLM_API_KEY=
# Gemini 原生根路径（…/v1beta）。若仍写成 …/v1 或 …/v1beta/openai，会自动改写到 …/v1beta。
# 中转站示例：https://api.zyai.online/v1beta
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.7
# json_schema | json_object | none
# Gemini 原生默认 json_object：大枚举 responseSchema 容易把 beats 裁空；本地 validate+repair 仍会把关
LLM_STRUCTURED_OUTPUT=json_object
# 官方 Google AIza… key 会自动用 x-goog-api-key；中转站 sk-… 用 Bearer。可强制：api-key | bearer
# GEMINI_AUTH=

# ---- ASR / 逐字对照 -------------------------------------------------------------
# auto | groq | external | vectcut
# auto 顺序：Groq Whisper（默认，本仓库已验证的方案）→ ASR_ALIGN_URL 自定义接口 → VectCut 识别字幕
ASR_PROVIDER=auto
# 默认：Groq Whisper 词级时间戳 + 本地字符级对齐（Levenshtein），文案作为 prompt 提升识别
GROQ_API_KEY=
GROQ_WHISPER_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_WHISPER_MODEL=whisper-large-v3
# Whisper prompt：留空=不传（默认，最稳）；script=传整段文案（部分片段会诱发幻听）；或写几个领域词
GROQ_WHISPER_PROMPT=
# 转写与文案的对齐覆盖率低于此值：换模型重试一次，仍低则用 VectCut 兜底
ASR_MIN_COVERAGE=0.6
# 可选：你自己的“文案 ↔ 音频 逐字对照”接口（返回带时间戳的字/词即可，格式宽松解析）
ASR_ALIGN_URL=
ASR_ALIGN_API_KEY=
ASR_ALIGN_METHOD=POST
ASR_ALIGN_AUDIO_FIELD=audio_url
ASR_ALIGN_TEXT_FIELD=text
ASR_ALIGN_LANGUAGE_FIELD=language
# 兜底：VectCut 识别字幕 sta 模式（计费，约 3 积分/条），档位 basic | nlp | llm | llm_vad
VECTCUT_ASR_MODE=nlp

# ---- VectCut 流光剪辑 -----------------------------------------------------------
VECTCUT_API_KEY=
VECTCUT_BASE_URL=https://open.vectcut.com

# ---- 声音设计 ---------------------------------------------------------------------
# 背景音乐音量，线性值（1 = 原音量）。VectCut 的 volume 参数是 dB，程序内部自动换算：0.12 → -18.42 dB。
BGM_VOLUME=0.12
# 音效总音量（线性），每条音效再乘以素材库里的 gain。
SFX_VOLUME=0.55
# 固定使用某一首背景音乐（留空 = 由 AI 从曲库选，默认倾向 talk_default；none = 不加）
# 默认口播垫乐：
# BGM_URL=https://lf3-lv-music-tos.faceu.com/obj/tos-cn-ve-2774/oYACBQRCMlWBIrZipvQZhI5LAlUFYii0RwEPh
BGM_URL=

# ---- 开拍前素材检查 / 渲染后审片（默认开启；--no-inspect / --review / --fix）------------
# 需要 ffmpeg + ffprobe 在 PATH 上（开拍前抽一帧、渲染后抽帧拼 contact-sheet.jpg、ffprobe 技术门禁）；
# 视觉打分复用上面的 Gemini 配置。下载成片优先用 fetch，失败时用 curl 兜底。
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# CURL_PATH=curl

# ---- B-roll 图片生成 -------------------------------------------------------------
# gemini（默认：Gemini 原生 generateContent 生图，key/base 复用 LLM_*）|
# vectcut（VectCut 聚合生图，无需上传）| openai-compatible | none
IMAGE_PROVIDER=gemini
IMAGE_MODEL=gemini-3.1-flash-image-preview
# 一般不用单独填：默认用 LLM_API_KEY + LLM_BASE_URL（resolve 到 /v1beta）
# IMAGE_API_KEY=
# IMAGE_BASE_URL=https://api.zyai.online/v1beta
# VectCut 聚合兜底：
VECTCUT_IMAGE_MODEL=nano_banana_2
# OpenAI 兼容 /images/generations：
# IMAGE_PROVIDER=openai-compatible
# IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# IMAGE_MODEL=imagen-4.0-generate-001
